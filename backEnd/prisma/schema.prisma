generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id           Int       @id @default(autoincrement())
  nomeCompleto String
  email        String    @unique
  senha        String
  telefone     String
  cpf          String    @unique
  tipoDaConta  Role
  empresaId    Int
  servico      Servico[]
  empresa      Empresa   @relation(fields: [empresaId], references: [id])
}

model Cliente {
  id          Int           @id @default(autoincrement())
  email       String?       @unique
  telefone    String?
  empresaId   Int
  nome        String
  Sobrenome   String
  Agendamento Agendamento[]
  empresa     Empresa       @relation(fields: [empresaId], references: [id])
  servico     Servico[]
}

model GestaoFinanceira {
  id                 Int      @id @default(autoincrement())
  data               DateTime @default(now())
  hora               String
  descricao          String
  valor              Float
  colaboradorId      Int?
  servicoAssociadoId Int?
  categoriaId        Int?
  empresaId          Int

  categoria        Categoria?   @relation(fields: [categoriaId], references: [id])
  colaborador      Colaborador? @relation(fields: [colaboradorId], references: [id])
  empresa          Empresa      @relation(fields: [empresaId], references: [id])
  servicoAssociado Servico?     @relation(fields: [servicoAssociadoId], references: [id])
}

model Categoria {
  id               Int                @id @default(autoincrement())
  nomeCategoria    String
  empresaId        Int
  empresa          Empresa            @relation(fields: [empresaId], references: [id])
  gestaoFinanceira GestaoFinanceira[]
}

model Servico {
  id               Int                @id @default(autoincrement())
  tipoDoServico    String
  valorDoServico   Float
  data             DateTime
  hora             String
  empresaId        Int
  usuarioId        Int
  colaboradorId    Int
  clienteId        Int
  servicoConfigId  Int
  duracao          Int?
  gestaoFinanceira GestaoFinanceira[]
  cliente          Cliente            @relation(fields: [clienteId], references: [id])
  colaborador      Colaborador        @relation(fields: [colaboradorId], references: [id])
  empresa          Empresa            @relation(fields: [empresaId], references: [id])
  servicoConfig    ServicoConfig      @relation(fields: [servicoConfigId], references: [id])
  usuario          Usuario            @relation(fields: [usuarioId], references: [id])
}

model Empresa {
  id               Int                @id @default(autoincrement())
  nomeDaEmpresa    String             @unique
  cnpj             String             @unique
  email            String             @unique
  telefone         String
  endereco         String
  agendamento      Agendamento[]
  BloqueioAgenda   BloqueioAgenda[]
  categorias       Categoria[]
  clientes         Cliente[]
  colaboradores    Colaborador[]
  gestaoFinanceira GestaoFinanceira[]
  servico          Servico[]
  ServicoConfig    ServicoConfig[]
  usuarios         Usuario[]
  horarios         Horario[]
}

model Colaborador {
  id               Int                @id @default(autoincrement())
  nomeCompleto     String
  dataDeNascimento DateTime
  email            String             @unique
  tel              String
  senha            String?
  empresaId        Int
  avatar           String?
  agendamento      Agendamento[]
  BloqueioAgenda   BloqueioAgenda[]
  empresa          Empresa            @relation(fields: [empresaId], references: [id])
  GestaoFinanceira GestaoFinanceira[]
  horarios         Horario[]
  servicos         Servico[]
}

model ServicoConfig {
  id                 Int           @id @default(autoincrement())
  nome               String        @unique
  tipo               TipoDeServico
  preco              Float
  ativo              Boolean       @default(true)
  comissao           Float
  duracaoDoServico   Int?
  empresaId          Int
  Agendamento        Agendamento[]
  servicosRealizados Servico[]
  empresa            Empresa       @relation(fields: [empresaId], references: [id])
}

model Horario {
  id            Int                @id @default(autoincrement())
  diaSemana     DiaSemana[]
  start         DateTime
  end           DateTime
  colaboradorId Int?
  empresaId     Int

  criadoEm    DateTime    @default(now())
  colaborador Colaborador? @relation(fields: [colaboradorId], references: [id])
  empresa     Empresa     @relation(fields: [empresaId], references: [id])
}



  model Agendamento {
    id                Int      @id @default(autoincrement())
    
    start             DateTime
    end               DateTime

    clienteId       Int
    colaboradorId   Int
    servicoConfigId Int
    criadoEm        DateTime  @default(now())
    atualizadoEm    DateTime?

    empresaId     Int
    status        StatusAgendamento
    Cliente       Cliente           @relation(fields: [clienteId], references: [id])
    Colaborador   Colaborador       @relation(fields: [colaboradorId], references: [id])
    Empresa       Empresa           @relation(fields: [empresaId], references: [id])
    ServicoConfig ServicoConfig     @relation(fields: [servicoConfigId], references: [id])
  }

model BloqueioAgenda {
  id             Int      @id @default(autoincrement())
  start          DateTime
  end            DateTime
  motivo         String?

  colaboradorId Int
  empresaId     Int
  criadoEm      DateTime    @default(now())
  Colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  Empresa       Empresa     @relation(fields: [empresaId], references: [id])
}

enum TipoDeServico {
  Pacote
  Simples
  Combo
}

enum Role {
  USER
  ADMIN
}

enum StatusAgendamento {
  AGENDADO
  CONFIRMADO
  CANCELADO
  FINALIZADO
}

enum DiaSemana {
  DOMINGO
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
}
